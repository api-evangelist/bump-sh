{
  "info": {
    "_postman_id": "4d4f41fa-9f36-47de-bdf5-43afa0457aee",
    "name": "Bump.sh Api Branches Versions API",
    "description": "This is the official Bump.sh API documentation.  Obviously created\nwith Bump.sh.\n\nThe Bump.sh API is a REST API. It enables you to [create, update](#operation-post-versions)\nor [preview](#operation-post-previews) your API(s) documentation,\n[create stand-alone documentation diffs](#operation-post-diffs) or\n[validate a documentation definition](#operation-post-validations)\n(currently in OpenAPI or AsyncAPI).\n\nOur [webhook](#webhook-documentation-change) also lets you get\nnotifications every time a change is introduced in your API.\n",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T01:16:44.000Z",
    "updatedAt": "2026-07-28T01:16:44.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-4d4f41fa-9f36-47de-bdf5-43afa0457aee"
  },
