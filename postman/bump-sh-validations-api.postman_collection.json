          "id": "1fb1f887-0693-4339-b1f7-e735ab590b31",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentation\": \"<string>\",\n  \"hub\": \"<string>\",\n  \"documentation_name\": \"<string>\",\n  \"auto_create_documentation\": false,\n  \"definition\": \"<string>\",\n  \"references\": [\n    {\n      \"location\": \"<string>\",\n      \"content\": \"<string>\"\n    },\n    {\n      \"location\": \"<string>\",\n      \"content\": \"<string>\"\n    }\n  ],\n  \"url\": \"<uri>\",\n  \"id\": \"<string>\",\n  \"expires_at\": \"<dateTime>\",\n  \"public_url\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/validations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "validations"
              ]
            },
            "description": "Validate a definition against its schema (OpenAPI or AsyncAPI) and return errors without creating a new version. This is useful in a CI process, to validate that a changed definition file is valid and won't fail when being deployed on Bump.sh.\n"
