                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/previews/:preview_id",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "previews",
                    ":preview_id"
                  ],
                  "variable": [
                    {
                      "id": "7ba8d4f3-aba0-47c5-99dd-8ee85fe360bc",
                      "key": "preview_id",
                      "value": "<string>",
                      "description": "(Required) UUID of an existing preview you wish to update."
                    }
                  ]
                },
                "description": "Update a preview with the given documentation file. The preview will stay active for 30 minutes after the last update.\n"
