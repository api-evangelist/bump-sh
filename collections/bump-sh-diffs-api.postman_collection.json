          "name": "Create a Diff",
          "request": {
            "name": "Create a Diff",
            "description": {
              "content": "Create a diff between any two given API definitions.\n\nThe diff result will be available asynchronously and needs\nto be retrieved with the [`GET /diffs/:id` API endpoint](#operation-get-diffs-parameter).\n",
              "type": "text/plain"
            },
            "url": {
